---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { langOf, href } from '../i18n';
import { useT } from '../i18n/ui';
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const n = site.welcomeDiscount;
---
<div class="popup" data-popup hidden>
  <div class="popup__backdrop" data-popup-close></div>
  <div class="popup__box" role="dialog" aria-modal="true" aria-labelledby="popup-title" data-newsletter-box>
    <div class="popup__content">
      <img src="/images/site/logo.png" alt="Mekie" width="160" height="53" class="popup__logo" />

      <div data-before>
        <p id="popup-title" class="popup__title">{t('popup.title', { n })}</p>
        <p class="popup__sub">{t('popup.sub')}</p>
      </div>

      <form class="popup__form" data-newsletter="popup" novalidate>
        <label class="sr-only" for="popup-email">Email</label>
        <input class="popup__input" id="popup-email" type="email" name="email" placeholder="EMAIL" required autocomplete="email" data-autofocus />
        <label class="popup__consent">
          <input type="checkbox" name="consent" value="yes" required />
          <span>{t('popup.consent')} <a href={href(lang, '/politica-de-privacidade/')} class="link-underline">{t('popup.privacy')}</a></span>
        </label>
        <button class="pill pill--accent pill--block" type="submit">{t('popup.cta', { n })}</button>
        <p class="popup__msg" role="alert" data-msg hidden></p>
      </form>

      <div class="popup__done" data-success hidden>
        <p class="popup__title" data-success-title>{t('news.done')}</p>
        <p class="popup__sub" data-success-sub>{t('popup.useCode')}</p>
        <div class="code" data-code-wrap><code>{site.welcomeCode}</code><button type="button" class="code__copy eyebrow" data-copy-code>{t('popup.copy')}</button></div>
        <button type="button" class="pill pill--block" data-popup-close>{t('popup.keep')}</button>
      </div>

      <p class="popup__fine">{t('popup.fine')}</p>
    </div>
    <div class="popup__media">
      <img src="/images/lookbook/mushrooms-duo-sm.webp" alt="" width="540" height="810" loading="lazy" />
    </div>
    <button type="button" class="popup__close" aria-label={t('close')} data-popup-close><Icon name="close" size={18} /></button>
  </div>
</div>

<div class="ptab" data-popup-tab hidden>
  <button type="button" class="ptab__open eyebrow" data-popup-open>{t('popup.tab', { n })}</button>
  <button type="button" class="ptab__x" aria-label={t('popup.hide')} data-tab-dismiss><Icon name="close" size={12} /></button>
</div>

<style>
  .popup { position: fixed; inset: 0; z-index: 120; display: grid; place-items: center; padding: 16px; }
  .popup[hidden] { display: none; }
  .popup__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.45); animation: fadeP .3s; }
  .popup__box {
    position: relative;
    display: grid; grid-template-columns: 1.3fr 1fr;
    width: min(800px, 100%);
    max-height: calc(100svh - 32px);
    overflow: auto;
    background: var(--bg);
    box-shadow: 0 30px 60px rgba(0,0,0,.25);
    animation: popIn .4s var(--ease);
  }
  .popup__content { padding: 44px 32px 28px; display: grid; justify-items: center; text-align: center; align-content: center; gap: 4px; }
  .popup__logo { height: 38px; width: auto; margin-bottom: 18px; }
  .popup__title { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 24px; line-height: 1.15; }
  .popup__sub { margin: 8px auto 22px; font-size: 13.5px; color: var(--ink-soft); max-width: 34ch; }
  .popup__form { width: 100%; display: grid; gap: 12px; }
  .popup__input {
    height: 46px; border-radius: 999px; border: 1px solid var(--ink);
    padding: 0 18px; background: transparent; font-size: 12px; letter-spacing: .06em;
  }
  .popup__input:focus { outline: none; box-shadow: 0 0 0 2px var(--ink); }
  .popup__consent { display: flex; gap: 10px; text-align: left; font-size: 11.5px; line-height: 1.45; color: var(--ink-soft); }
  .popup__consent input { margin-top: 2px; accent-color: var(--accent); flex: none; }
  .popup__msg { margin: 0; font-size: 12.5px; color: var(--sale); }
  .popup__done { width: 100%; display: grid; gap: 4px; justify-items: center; }
  .popup__done .pill { margin-top: 14px; }
  .code {
    display: flex; align-items: center; gap: 14px;
    border: 1px dashed var(--ink); padding: 10px 14px 10px 20px;
  }
  .code code { font-family: var(--font-body); font-size: 20px; font-weight: 600; letter-spacing: .12em; user-select: all; }
  .code__copy { font-size: 10.5px; text-decoration: underline; text-underline-offset: 3px; }
  .popup__fine { margin: 16px 0 0; font-size: 10.5px; color: var(--ink-soft); }
  .popup__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .popup__close {
    position: absolute; top: 12px; right: 12px;
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(255,255,255,.85); display: grid; place-items: center;
  }
  @keyframes popIn { from { opacity: 0; transform: translateY(16px) scale(.98); } }
  @keyframes fadeP { from { opacity: 0; } }
  @media (max-width: 640px) {
    .popup__box { grid-template-columns: 1fr; }
    .popup__media { display: none; }
    .popup__content { padding: 40px 20px 24px; }
  }

  .ptab {
    position: fixed; left: 16px; bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 45;
    display: flex; align-items: center;
    background: var(--ink); color: #fff; border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
    animation: popIn .4s var(--ease);
  }
  .ptab[hidden] { display: none; }
  .ptab__open { padding: 12px 6px 12px 18px; font-size: 10.5px; }
  .ptab__x { width: 32px; height: 36px; display: grid; place-items: center; opacity: .7; }
  .ptab__x:hover { opacity: 1; }
  :global(body:has(.sticky-buy:not([hidden]))) .ptab { bottom: calc(84px + env(safe-area-inset-bottom, 0px)); }
</style>
