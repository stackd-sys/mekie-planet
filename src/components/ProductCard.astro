---
import Img from './Img.astro';
import { type Product, discount, variantsOf, cartInfo, totalStock, isSoldOut } from '../data/products';
import { langOf, href, money } from '../i18n';
import { useT } from '../i18n/ui';
import { shop } from '../i18n/data';
import { ratingOf } from '../data/reviews';
import Stars from './Stars.astro';
interface Props { product: Product; eager?: boolean }
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
/* aceita o produto em português ou já traduzido: os textos vêm sempre na língua da página */
const p = shop(lang).tr(Astro.props.product);
const { eager = false } = Astro.props;
const url = href(lang, `/produto/${p.slug}/`);
const off = discount(p);
const colors = variantsOf(p).length;
const label = p.badge ?? (isSoldOut(p) ? t('soldout') : off > 0 ? `-${off}%` : undefined);
const cartData = JSON.stringify({ ...cartInfo(p), href: url });
const rating = ratingOf(p);
const total = totalStock(p);
const soldOut = isSoldOut(p);
const sizes = '(max-width: 700px) 50vw, 25vw';
/* recortes de produto (fundo transparente) ficam inteiros; fotos ocupam o cartão */
const cutout = /\/products\/.+-1\.webp$/.test(p.images[0]);
/* segunda foto: aparece ao passar o rato; no telemóvel desliza-se para o lado */
const alt = p.images[1];
const altCutout = alt ? /\/products\/.+\.webp$/.test(alt) && !/lookbook/.test(alt) : false;
---
<article class="card" data-card data-product={cartData}>
  <div class="card__media">
    <a href={url} class="card__link" aria-label={`${p.name}, ${p.color}`}>
      {label && <span class="card__tag eyebrow">{label}</span>}
      <span class:list={['card__track', { 'card__track--two': alt }]} data-card-track>
        <Img src={p.images[0]} sizes={sizes} alt={`${p.name} ${p.color}`} width="600" height="750" loading={eager ? 'eager' : 'lazy'} class:list={['card__img', { 'card__img--photo': !cutout }]} />
        {alt && <Img src={alt} sizes={sizes} alt="" width="600" height="750" loading="lazy" class:list={['card__img', 'card__img--alt', { 'card__img--photo': !altCutout }]} />}
      </span>
    </a>
    {alt && <span class="card__dots" aria-hidden="true"><i class="is-on"></i><i></i></span>}
    <div class="quick" aria-label={t('card.addTo', { name: p.name })}>
      {soldOut ? (
        <p class="quick__label eyebrow">{t('soldout')}</p>
      ) : p.customizable ? (
        <a href={url} class="quick__one eyebrow">{t('card.pickColors')}</a>
      ) : p.sizes ? (
        <>
          <p class="quick__label eyebrow">{t('card.quick')}</p>
          <div class="quick__sizes">
            {p.sizes.map((s) => {
              const out = !!p.sizeStock && !p.sizeStock[s];
              return <button type="button" class:list={['quick__size', { 'is-out': out }]} data-quick={s} disabled={out} aria-label={out ? t('card.sizeOut', { s }) : t('card.addSize', { s })} title={out ? t('soldout') : undefined}>{s}</button>;
            })}
          </div>
        </>
      ) : (
        <button type="button" class="quick__one eyebrow" data-quick="">{t('add')}</button>
      )}
    </div>
  </div>
  <div class="card__body">
    <h3 class="card__title"><a href={url}>{p.name}</a></h3>
    <p class="price">
      {off > 0 && <del><span class="sr-only">{t('price.was')}</span>{money(p.regularPrice, lang)}</del>}
      {off > 0 ? <ins><span class="sr-only">{t('price.now')}</span>{money(p.price, lang)}</ins> : <span>{money(p.price, lang)}</span>}
    </p>
    {rating && <p class="card__rating"><Stars rating={rating.value} size={11} /><span>({rating.count})</span></p>}
    <p class="card__meta eyebrow">{colors > 1 ? t('card.colors', { n: colors }) : p.color}</p>
    {!p.madeToOrderDays && total !== undefined && total > 0 && total <= 3 && <p class="card__stock eyebrow">{total === 1 ? t('card.last1') : t('card.lastN', { n: total })}</p>}
  </div>
</article>

<style>
  .card__rating { display: flex; justify-content: center; align-items: center; gap: 6px; margin: 4px 0 0; font-size: 11px; color: var(--ink-soft); }
  .card { position: relative; display: flex; flex-direction: column; text-align: center; }
  .card__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  .card__link { position: absolute; inset: 0; display: block; }
  .card__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    padding: 6%;
    transition: opacity .5s var(--ease), transform .8s var(--ease);
  }
  .card__img--photo { object-fit: cover; padding: 0; }
  .card__track { position: absolute; inset: 0; display: block; }
  .card__dots { display: none; }
  /* computador: a segunda foto aparece ao passar o rato */
  @media (hover: hover) {
    .card__img--alt { opacity: 0; }
    .card__media:hover .card__img { transform: scale(1.03); }
    .card__media:hover .card__track--two .card__img:not(.card__img--alt) { opacity: 0; }
    .card__media:hover .card__img--alt { opacity: 1; }
  }
  /* telemóvel: desliza para o lado, com dois pontos a indicar a foto */
  @media (hover: none) {
    .card__track--two { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
    .card__track--two::-webkit-scrollbar { display: none; }
    .card__track--two .card__img { position: relative; inset: auto; flex: 0 0 100%; scroll-snap-align: start; }
    .card__dots { display: flex; gap: 5px; position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%); z-index: 2; pointer-events: none; }
    .card__dots i { width: 5px; height: 5px; border-radius: 50%; background: rgba(0,0,0,.22); }
    .card__dots i.is-on { background: var(--ink); }
  }
  .card__tag {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    font-size: 10.5px; color: var(--ink);
    background: rgba(255,255,255,.88); padding: 4px 8px;
  }

  .quick {
    position: absolute; left: 10px; right: 10px; bottom: 10px; z-index: 3;
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(6px);
    padding: 12px;
    display: grid; gap: 8px; justify-items: center;
    opacity: 0; transform: translateY(8px);
    transition: opacity .3s var(--ease), transform .3s var(--ease);
  }
  .card__media:hover .quick, .quick:focus-within { opacity: 1; transform: none; }
  .quick__label { margin: 0; font-size: 10px; color: var(--ink-soft); }
  .quick__sizes { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .quick__size {
    min-width: 36px; height: 32px; padding: 0 6px;
    border: 1px solid var(--line); font-size: 12px;
    transition: background .2s, color .2s, border-color .2s;
  }
  .quick__size:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .quick__size.is-out { color: #b5b5b5; text-decoration: line-through; cursor: not-allowed; }
  .quick__size.is-out:hover { background: transparent; color: #b5b5b5; border-color: var(--line); }
  .quick__one { width: 100%; height: 36px; font-size: 10.5px; display: grid; place-items: center; }
  .quick__one:hover { text-decoration: underline; text-underline-offset: 3px; }
  .quick.is-added::after {
    content: 'Adicionado ✓'; position: absolute; inset: 0;
    display: grid; place-items: center; background: var(--accent); color: #fff;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
  }

  .card__body { padding-top: 16px; display: grid; gap: 4px; justify-items: center; }
  .card__title { margin: 0; font-size: 13.5px; font-weight: 500; }
  .card__meta { margin: 8px 0 0; font-size: 10px; color: var(--ink-soft); }
  .card__stock { margin: 0; font-size: 10px; color: var(--sale); }
  @media (hover: none) {
    .quick { display: none; }
  }
</style>
