---
import ProductCard from './ProductCard.astro';
import Img from './Img.astro';
import type { Product } from '../data/products';
import { langOf, href } from '../i18n';
import { useT } from '../i18n/ui';
import { shop } from '../i18n/data';
interface Props { title: string; intro?: string; products: Product[]; current: string; image?: string }
const { title, intro, current, image } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const s = shop(lang);
const products = Astro.props.products.map(s.tr);
const chips = [
  { href: href(lang, '/loja/'), label: t('grid.everything'), key: '' },
  ...(s.lowStock().length ? [{ href: href(lang, '/loja/ultimas-unidades/'), label: t('last'), key: 'ultimas-unidades' }] : []),
  ...s.categories.filter((c) => c.slug !== 'acessorios').map((c) => ({ href: href(lang, `/loja/${c.slug}/`), label: c.name, key: c.slug, soon: s.productsIn(c.slug).length === 0 })),
];
---
{image ? (
  <section class="banner">
    <Img src={image} sizes="100vw" alt="" width="1200" height="800" class="banner__img" />
    <div class="banner__shade"></div>
    <div class="banner__inner container">
      <h1 class="banner__title display">{title}</h1>
      {intro && <p class="banner__intro">{intro}</p>}
    </div>
  </section>
) : (
  <header class="head container">
    <h1 class="head__title">{title}</h1>
    {intro && <p class="head__intro">{intro}</p>}
  </header>
)}

<div class="toolbar-wrap">
  <div class="toolbar container">
    <div class="view" role="group" aria-label={t('grid.view')}>
      <button type="button" class="view__btn" data-cols="2" aria-label={t('grid.big')} aria-pressed="false">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="0" y="0" width="7" height="7" /><rect x="9" y="0" width="7" height="7" /><rect x="0" y="9" width="7" height="7" /><rect x="9" y="9" width="7" height="7" /></svg>
      </button>
      <button type="button" class="view__btn is-active" data-cols="4" aria-label={t('grid.compact')} aria-pressed="true">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">{[0, 6, 12].flatMap((y) => [0, 6, 12].map((x) => <rect x={x} y={y} width="4" height="4" />))}</svg>
      </button>
    </div>
    <p class="toolbar__count eyebrow">{products.length} {products.length === 1 ? t('grid.one') : t('grid.many')}</p>
    <label class="sort eyebrow">
      <span>{t('grid.sort')}</span>
      <select data-sort aria-label={t('grid.sortLabel')} disabled={products.length < 2}>
        <option value="featured">{t('grid.featured')}</option>
        <option value="price-asc">{t('grid.priceAsc')}</option>
        <option value="price-desc">{t('grid.priceDesc')}</option>
        <option value="name">{t('grid.name')}</option>
      </select>
    </label>
  </div>
  <nav class="chips container" aria-label={t('grid.filter')}>
    {chips.map((c) => (
      <a href={c.href} class:list={['chip eyebrow', { 'is-active': c.key === current }]} aria-current={c.key === current ? 'page' : undefined}>
        {c.label}{c.soon && <small> · {t('grid.soonSmall')}</small>}
      </a>
    ))}
  </nav>
</div>

<div class="container">
  {products.length > 0 ? (
    <ul class="grid" data-grid>
      {products.map((p, i) => (
        <li data-price={p.price} data-name={p.name} data-index={i}><ProductCard product={p} eager={i < 4} /></li>
      ))}
    </ul>
  ) : (
    <div class="soon">
      <p class="display soon__title">{t('grid.soonTitle')}</p>
      <p>{t('grid.soonText')}</p>
      <div class="soon__actions">
        <a href={href(lang, '/loja/')} class="pill">{t('shop.go')}</a>
        <button type="button" class="pill pill--outline" data-popup-open>{t('grid.notifyMe')}</button>
      </div>
    </div>
  )}
</div>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const select = document.querySelector<HTMLSelectElement>('[data-sort]');
  select?.addEventListener('change', () => {
    if (!grid) return;
    const items = [...grid.children] as HTMLElement[];
    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      featured: (a, b) => +a.dataset.index! - +b.dataset.index!,
      'price-asc': (a, b) => +a.dataset.price! - +b.dataset.price! || +a.dataset.index! - +b.dataset.index!,
      'price-desc': (a, b) => +b.dataset.price! - +a.dataset.price! || +a.dataset.index! - +b.dataset.index!,
      name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!, document.documentElement.lang),
    };
    items.sort(by[select.value]).forEach((el) => grid.appendChild(el));
  });

  const KEY = 'mekie-grid';
  const setCols = (cols: string) => {
    grid?.setAttribute('data-cols', cols);
    document.querySelectorAll<HTMLButtonElement>('[data-cols]').forEach((b) => {
      const on = b.dataset.cols === cols;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
  };
  try { const saved = localStorage.getItem(KEY); if (saved) setCols(saved); } catch {}
  document.querySelectorAll<HTMLButtonElement>('button[data-cols]').forEach((b) =>
    b.addEventListener('click', () => {
      setCols(b.dataset.cols!);
      try { localStorage.setItem(KEY, b.dataset.cols!); } catch {}
    }),
  );
</script>

<style>
  .head { text-align: center; padding-top: clamp(32px, 5vw, 64px); padding-bottom: clamp(20px, 3vw, 32px); }
  .head__title { margin: 0; font-weight: 400; font-size: clamp(20px, 2vw, 24px); letter-spacing: .1em; text-transform: uppercase; }
  .head__intro { margin: 10px auto 0; max-width: 520px; font-size: 13.5px; color: var(--ink-soft); }

  .banner {
    position: relative; color: #fff; background: #222; overflow: hidden;
    min-height: clamp(320px, 42vw, 520px); display: grid; align-items: end;
  }
  .banner__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .banner__shade { position: absolute; inset: 0; background: linear-gradient(transparent 35%, rgba(0,0,0,.55)); }
  .banner__inner { position: relative; padding-bottom: clamp(28px, 4vw, 48px); text-align: center; }
  .banner__title { margin: 0; font-size: clamp(40px, 7vw, 88px); text-transform: uppercase; }
  .banner__intro { margin: 12px auto 0; max-width: 520px; font-size: 14.5px; opacity: .9; }

  .toolbar-wrap { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 36px; }
  .toolbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 52px; }
  .view { display: flex; gap: 6px; }
  .view__btn { width: 30px; height: 30px; display: grid; place-items: center; color: var(--line); }
  .view__btn svg { fill: currentColor; }
  .view__btn.is-active, .view__btn:hover { color: var(--ink); }
  .toolbar__count { margin: 0; font-size: 10.5px; color: var(--ink-soft); }
  .sort { justify-self: end; display: flex; align-items: center; gap: 4px; font-size: 10.5px; color: var(--ink-soft); }
  .sort select {
    border: 0; background: transparent; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
    padding: 6px 2px; cursor: pointer; color: var(--ink);
  }
  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-top: 12px; padding-bottom: 12px; border-top: 1px solid var(--line); }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    font-size: 10px; white-space: nowrap;
    padding: 7px 13px; border-radius: 999px; border: 1px solid var(--line);
    transition: border-color .2s, background .2s;
  }
  .chip small { font-size: inherit; color: var(--ink-soft); text-transform: none; letter-spacing: 0; }
  .chip:hover { border-color: var(--ink); }
  .chip.is-active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .chip.is-active small { color: #ccc; }

  .grid {
    list-style: none; margin: 0; padding: 0 0 clamp(56px, 8vw, 110px);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px 24px;
  }
  .grid[data-cols="2"] { grid-template-columns: repeat(2, 1fr); gap: 56px 32px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) {
    .sort > span { display: none; }
    .toolbar__count { font-size: 10px; }
    .grid, .grid[data-cols="2"] { grid-template-columns: repeat(2, 1fr); gap: 32px 12px; }
    .grid[data-cols="2"] { grid-template-columns: 1fr; }
    .view__btn[data-cols="2"] svg rect:nth-child(n+2) { display: none; }
    .view__btn[data-cols="2"] svg rect:first-child { width: 16px; height: 16px; }
  }

  .soon { text-align: center; padding: 40px 0 120px; display: grid; justify-items: center; gap: 6px; }
  .soon__title { font-size: 40px; margin: 0 0 8px; }
  .soon p { margin: 0; color: var(--ink-soft); }
  .soon__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 24px; }
</style>
