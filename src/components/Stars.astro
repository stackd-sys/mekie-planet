---
/* Cinco estrelas, preenchidas conforme a nota (0 a 5) */
interface Props { rating: number; size?: number; class?: string }
const { rating, size = 12, class: cls } = Astro.props;
const path = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
---
<span class:list={['stars', cls]} role="img" aria-label={`${String(rating).replace('.', ',')} em 5 estrelas`}>
  {[0, 1, 2, 3, 4].map((i) => (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class:list={{ 'is-off': rating < i + 0.5 }}><path d={path} /></svg>
  ))}
</span>

<style>
  .stars { display: inline-flex; gap: 2px; vertical-align: middle; }
  .stars svg { fill: var(--ink); }
  .stars svg.is-off { fill: var(--line); }
</style>
