---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { langOf, href } from '../i18n';
import { useT } from '../i18n/ui';
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
---
<Base title={t('ok.title')} noindex popup={false}>
  <section class="container ok">
    <p class="eyebrow ok__kicker">{t('ok.thanks')}</p>
    <h1 class="display ok__title" data-title>{t('ok.heading')}</h1>
    <p class="ok__num" data-ok-num hidden set:html={t('ok.number')} />
    <div data-paid hidden>
      <p>{t('ok.paid1')}</p>
      <p>{t('ok.paid2')}</p>
    </div>
    <div data-unpaid>
      <p>{t('ok.unpaid')}</p>
    </div>
    <p set:html={t('ok.questions', { email: `<a class="link-underline" href="mailto:${site.email}">${site.email}</a>` })} />
    <a href={href(lang, '/loja/')} class="pill">{t('shop.continue')}</a>
  </section>
</Base>

<script>
  import { cart } from '../scripts/cart';
  import { track, consentSettled, countEvent } from '../scripts/consent';
  import { tc, money } from '../i18n/client';
  const q = new URLSearchParams(location.search);
  const n = q.get('n'), t = q.get('t') || '';
  const paid = q.get('pago') === '1';
  if (n) {
    document.querySelector('[data-n]')!.textContent = n;
    document.querySelector('[data-t]')!.textContent = /€/.test(t) ? t : money(Number(t));
    document.querySelector<HTMLElement>('[data-ok-num]')!.hidden = false;
  }
  if (paid) {
    /* voltou da página de pagamento: o carrinho já não faz falta */
    cart.clear();
    try { localStorage.setItem('mekie-code-applied', ''); } catch {}
    document.querySelector<HTMLElement>('[data-paid]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-unpaid]')!.hidden = true;
    document.querySelector('[data-title]')!.textContent = tc('ok.paid');
    const value = Number(t.replace(/[^\d,.]/g, '').replace(',', '.')) || 0;
    const send = () => track('purchase', [], { transaction_id: n, value, currency: 'EUR' });
    let sent = false;
    try { sent = sessionStorage.getItem(`mekie-purchase-${n}`) === '1'; sessionStorage.setItem(`mekie-purchase-${n}`, '1'); } catch {}
    if (!sent) {
      if (consentSettled()) send();
      else { countEvent('purchase'); document.addEventListener('mekie:consent', send, { once: true }); }
    }
  }
</script>

<style>
  .ok { max-width: 640px; padding-top: clamp(48px, 8vw, 110px); padding-bottom: clamp(56px, 8vw, 110px); }
  .ok__kicker { font-size: 11px; color: var(--ink-soft); margin: 0; }
  .ok__title { font-size: clamp(30px, 4vw, 48px); margin: 12px 0 22px; }
  .ok p { font-size: 15.5px; line-height: 1.7; margin: 0 0 14px; }
  .ok .pill { margin-top: 14px; }
</style>
