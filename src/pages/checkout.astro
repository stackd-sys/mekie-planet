---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { langOf, href } from '../i18n';
import { useT } from '../i18n/ui';
import { destinationsFor } from '../i18n/data';
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const h = (p: string) => href(lang, p);
/* com a Stripe ligada (na construção do site), o cliente paga logo na página seguinte */
const stripe = Boolean(process.env.STRIPE_SECRET_KEY);
const madeToMeasure = products.filter((p) => p.customizable).map((p) => p.id);
---
<Base title={t('cart.checkout')} noindex popup={false}>
  <div class="container co">
    <h1 class="display co__title">{t('cart.checkout')}</h1>
    <p class="co__code-msg is-error co__cancel" role="alert" data-co-cancel hidden>{t('co.cancel')}</p>

    <div class="co__empty" data-co-empty hidden>
      <p>{t('cart.empty')}</p>
      <a href={h('/loja/')} class="pill">{t('cart.toShop')}</a>
    </div>

    <div class="co__grid" data-co-grid>
      <form class="co__form" data-co-form>
        <fieldset>
          <legend class="eyebrow">{t('co.contact')}</legend>
          <input class="field" name="email" type="email" placeholder="E-mail" required autocomplete="email" />
          <input class="field" name="telefone" type="tel" placeholder={t('co.phone')} required autocomplete="tel" />
        </fieldset>
        <fieldset>
          <legend class="eyebrow" data-ship-legend>{t('co.delivery')}</legend>
          <div class="two">
            <input class="field" name="nome" placeholder={t('co.first')} required autocomplete="given-name" />
            <input class="field" name="apelido" placeholder={t('co.last')} required autocomplete="family-name" />
          </div>
          <div class="co__ship" data-ship-fields>
          <input class="field" name="morada" placeholder={t('co.address')} required autocomplete="street-address" />
          <div class="two">
            <input class="field" name="codigo_postal" placeholder={t('co.postcode')} required autocomplete="postal-code" pattern="[0-9]{4}-?[0-9]{3}|.{3,}" />
            <input class="field" name="localidade" placeholder={t('co.city')} required autocomplete="address-level2" />
          </div>
          <select class="field" name="pais" required autocomplete="country-name" data-country>
            {destinationsFor(lang).map((d) => <option value={d.name} data-zone={d.zone}>{d.label}</option>)}
          </select>
          <p class="co__hint" set:html={t('co.zones', { href: h('/contactos/') })} />
          </div>
          <p class="co__hint" data-digital-note hidden>{t('co.digital')}</p>
          <input class="field" name="nif" placeholder={t('co.nif')} inputmode="numeric" />
          <textarea class="field" name="notas" placeholder={t('co.notes')}></textarea>
        </fieldset>
        <fieldset>
          <legend class="eyebrow">{t('co.code')}</legend>
          <div class="co__code">
            <input class="field" name="codigo" id="co-code" placeholder={t('co.codePh', { code: site.welcomeCode })} autocomplete="off" autocapitalize="characters" data-code-input />
            <button type="button" class="pill pill--outline" data-code-apply>{t('co.apply')}</button>
          </div>
          <p class="co__code-msg" data-code-msg hidden></p>
        </fieldset>
        <fieldset>
          <legend class="eyebrow">{t('gift')}</legend>
          <div class="co__code">
            <input class="field" name="cartao" placeholder={t('co.giftCode')} autocomplete="off" autocapitalize="characters" data-gift-input />
            <button type="button" class="pill pill--outline" data-gift-apply>{t('co.use')}</button>
          </div>
          <p class="co__code-msg" data-gift-msg hidden></p>
        </fieldset>
        <p class="co__code-msg" data-custom-note data-ids={JSON.stringify(madeToMeasure)} hidden>{t('co.custom')}</p>
        <label class="co__terms">
          <input type="checkbox" required />
          <span set:html={t('co.terms', { terms: h('/termos-e-condicoes-de-servico/'), privacy: h('/politica-de-privacidade/') })} />
        </label>
        <p class="co__code-msg is-error" role="alert" data-co-error hidden></p>
        <button type="submit" class="pill pill--accent pill--block co__submit" data-label={stripe ? t('co.pay') : t('co.send')}>{stripe ? t('co.pay') : t('co.send')}</button>
        {stripe
          ? <p class="co__note">{t('co.stripeNote')}</p>
          : <p class="co__note">{t('co.mailNote')}</p>}
      </form>

      <aside class="co__summary">
        <p class="eyebrow">{t('co.summary')}</p>
        <ul class="co__lines" data-co-lines></ul>
        <div class="co__row"><span>Subtotal</span><span data-cart-subtotal></span></div>
        <div class="co__row" data-co-discount-row hidden><span data-co-discount-label></span><span data-co-discount></span></div>
        <div class="co__row" data-co-ship-row><span>{t('co.shipping')}</span><span data-co-ship></span></div>
        <div class="co__row" data-co-gift-row hidden><span>{t('gift')}</span><span data-co-gift></span></div>
        <div class="co__row co__total"><span>Total</span><strong data-co-total></strong></div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { cart, money, href } from '../scripts/cart';
  import * as newsletter from '../scripts/newsletter';
  import { shippingCost, type Zone } from '../data/shipping';
  import { track, consentSettled, visitSource, countEvent } from '../scripts/consent';
  import { tc, lang, localPath, shortDate } from '../i18n/client';
  const CODE = newsletter.CODE;
  const RATE = 0.1;
  /* Código de desconto aplicado: validado no CRM; sem CRM, só o de boas-vindas */
  type Discount = { code: string; kind: 'percent' | 'fixed'; value: number };
  let discount: Discount | null = null;
  let applied = '';
  try { applied = localStorage.getItem('mekie-code-applied') || ''; } catch {}
  const welcomeFallback = (c: string): Discount | null => (c && c === CODE ? { code: CODE, kind: 'percent', value: RATE * 100 } : null);
  const EMAIL = document.documentElement.dataset.email || '';
  const made = (l: (typeof cart.lines)[number]) => (l.madeToOrderDays ? Math.max(0, l.qty - (l.stock ?? 0)) : 0);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const codeInput = document.querySelector<HTMLInputElement>('[data-code-input]')!;
  const codeMsg = document.querySelector<HTMLElement>('[data-code-msg]')!;
  if (applied) codeInput.value = applied;
  const country = document.querySelector<HTMLSelectElement>('[data-country]')!;
  const zone = () => (country.selectedOptions[0]?.dataset.zone ?? 'pt') as Zone;
  /* Cartão presente usado nesta encomenda: o saldo é confirmado pelo webhook quando existe */
  let gift = { code: '', balance: 0, verified: false };
  const totals = () => {
    const sub = cart.subtotal;
    /* o desconto e o envio grátis contam só os artigos físicos, antes do desconto */
    const goods = cart.goodsSubtotal;
    const disc = !discount ? 0 : Math.round((discount.kind === 'percent' ? goods * discount.value / 100 : Math.min(discount.value, goods)) * 100) / 100;
    const ship = shippingCost(zone(), goods, cart.grams);
    const before = Math.round((sub - disc + ship) * 100) / 100;
    const giftUsed = gift.verified ? Math.min(gift.balance, before) : 0;
    return { sub, disc, ship, giftUsed, total: before - giftUsed };
  };
  country.addEventListener('change', () => render(cart.lines));
  const describe = (d: Discount) => (d.kind === 'percent' ? tc('co.percent', { n: lang === 'en' ? String(d.value) : String(d.value).replace('.', ',') }) : tc('co.fixed', { n: money(d.value) }));
  const applyCode = async (value: string, quiet = false) => {
    codeMsg.hidden = quiet;
    let result: Discount | null = null;
    let message = tc('co.codeBad');
    if (value) {
      try {
        const email = document.querySelector<HTMLInputElement>('[name=email]')?.value || '';
        const res = await newsletter.codeCheck(value, email, cart.goodsSubtotal);
        if (res.status === 'ok') result = { code: res.code, kind: res.kind, value: res.value };
        else if (res.status === 'invalid') message = res.message;
        else result = welcomeFallback(value);
      } catch {
        result = welcomeFallback(value);
      }
    }
    discount = result;
    applied = result?.code ?? '';
    if (!quiet || !result) {
      codeMsg.hidden = !value;
      codeMsg.textContent = result ? tc('co.codeOk', { d: describe(result) }) : message;
      codeMsg.classList.toggle('is-error', !result);
    }
    try { localStorage.setItem('mekie-code-applied', applied); } catch {}
    render(cart.lines);
  };
  document.querySelector('[data-code-apply]')?.addEventListener('click', () => applyCode(codeInput.value.trim().toUpperCase()));
  if (applied) applyCode(applied, true);

  /* Só cartões presente no carrinho: sem morada nem portes */
  const shipFields = document.querySelector<HTMLElement>('[data-ship-fields]')!;
  shipFields.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => (el.dataset.req = ''));
  const giftInput = document.querySelector<HTMLInputElement>('[data-gift-input]')!;
  const giftMsg = document.querySelector<HTMLElement>('[data-gift-msg]')!;
  const say = (el: HTMLElement, text: string, isError = false) => {
    el.hidden = false;
    el.textContent = text;
    el.classList.toggle('is-error', isError);
  };
  const dateOf = (iso?: string) => (iso ? shortDate(new Date(iso)) : '');
  document.querySelector('[data-gift-apply]')?.addEventListener('click', async () => {
    const code = giftInput.value.trim().toUpperCase();
    gift = { code: '', balance: 0, verified: false };
    if (!code) { giftMsg.hidden = true; render(cart.lines); return; }
    if (!newsletter.hasWebhook()) {
      gift = { code, balance: 0, verified: false };
      say(giftMsg, tc('co.giftLater'));
      render(cart.lines);
      return;
    }
    say(giftMsg, tc('co.giftChecking'));
    try {
      const res = await newsletter.giftCheck(code);
      if (res.status === 'ok' && (res.balance ?? 0) > 0) {
        gift = { code, balance: res.balance!, verified: true };
        say(giftMsg, tc('co.giftOk', { n: money(res.balance!), until: res.expires ? tc('co.giftUntil', { d: dateOf(res.expires) }) : '' }));
      } else if (res.status === 'unknown') {
        gift = { code, balance: 0, verified: false };
        say(giftMsg, tc('co.giftLater'));
      } else {
        say(giftMsg, res.status === 'empty' ? tc('co.giftEmpty') : res.status === 'expired' ? tc('co.giftExpired') : tc('co.giftNotFound'), true);
      }
    } catch {
      gift = { code, balance: 0, verified: false };
      say(giftMsg, tc('co.giftOffline'));
    }
    render(cart.lines);
  });

  const render = (lines: typeof cart.lines) => {
    const { sub, disc, ship, giftUsed, total } = totals();
    const physical = cart.hasPhysical;
    shipFields.hidden = !physical;
    shipFields.querySelectorAll<HTMLInputElement>('[data-req]').forEach((el) => (el.required = physical));
    document.querySelector<HTMLElement>('[data-digital-note]')!.hidden = physical || lines.length === 0;
    const customNote = document.querySelector<HTMLElement>('[data-custom-note]')!;
    customNote.hidden = !lines.some((l) => (JSON.parse(customNote.dataset.ids || '[]') as number[]).includes(Number(l.id)));
    document.querySelector<HTMLElement>('[data-ship-legend]')!.textContent = physical ? tc('co.delivery') : tc('co.yourData');
    document.querySelector<HTMLElement>('[data-co-ship-row]')!.hidden = !physical;
    document.querySelector<HTMLElement>('[data-co-gift-row]')!.hidden = giftUsed === 0;
    document.querySelector<HTMLElement>('[data-co-gift]')!.textContent = `-${money(giftUsed)}`;
    const discRow = document.querySelector<HTMLElement>('[data-co-discount-row]')!;
    discRow.hidden = disc === 0;
    document.querySelector<HTMLElement>('[data-co-discount-label]')!.textContent = tc('co.discount', { code: applied });
    document.querySelector<HTMLElement>('[data-co-discount]')!.textContent = `-${money(disc)}`;
    document.querySelector<HTMLElement>('[data-co-empty]')!.hidden = lines.length > 0;
    document.querySelector<HTMLElement>('[data-co-grid]')!.hidden = lines.length === 0;
    document.querySelector<HTMLElement>('[data-co-ship]')!.textContent = ship === 0 ? tc('co.free') : money(ship);
    document.querySelector<HTMLElement>('[data-co-total]')!.textContent = money(total);
    document.querySelector<HTMLElement>('[data-co-lines]')!.innerHTML = lines
      .map((l) => `<li><img src="${href(esc(l.image))}" alt="" width="64" height="80" /><span class="q">${l.qty}</span>
        <div><p>${esc(l.name)}</p><small>${esc(l.custom || l.color)}${l.size ? ` · ${esc(l.size)}` : ''}${made(l) ? `<br>${tc('line.made', { n: made(l), d: l.madeToOrderDays! })}` : ''}</small></div>
        <span>${money(l.qty * l.price)}</span></li>`)
      .join('');
  };
  cart.subscribe(render);

  const items = () => cart.lines.map((l) => ({ id: l.id, name: `${l.name} ${l.color}`, price: l.price, qty: l.qty, variant: l.size }));
  const started = () => { if (cart.lines.length) track('begin_checkout', items()); };
  if (consentSettled()) started();
  else { if (cart.lines.length) countEvent('begin_checkout'); document.addEventListener('mekie:consent', started, { once: true }); }

  const form = document.querySelector<HTMLFormElement>('[data-co-form]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[type=submit]');
  const codeError = (text: string) => {
    applied = '';
    try { localStorage.setItem('mekie-code-applied', ''); } catch {}
    codeMsg.hidden = false;
    codeMsg.textContent = text;
    codeMsg.classList.add('is-error');
    render(cart.lines);
    codeInput.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  const coError = document.querySelector<HTMLElement>('[data-co-error]')!;
  /* voltou da página de pagamento sem pagar */
  if (new URLSearchParams(location.search).has('cancelado')) document.querySelector<HTMLElement>('[data-co-cancel]')!.hidden = false;

  /* Grava a encomenda no CRM. Devolve false quando o CRM não está disponível (segue por email). */
  const sendToCrm = async (f: FormData) => {
    const payload = {
      lines: cart.lines.map((l) => ({ id: l.id, qty: l.qty, size: l.size ?? '', custom: l.custom ?? '' })),
      code: applied,
      gift: gift.code,
      utm: visitSource(),
      lang,
      customer: Object.fromEntries(['email', 'telefone', 'nome', 'apelido', 'nif', 'notas', 'morada', 'codigo_postal', 'localidade', 'pais'].map((k) => [k === 'telefone' ? 'phone' : k, String(f.get(k) ?? '')])),
    };
    let res: Response;
    try {
      res = await fetch('/api/encomenda/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    } catch {
      return false;
    }
    if (res.status === 503 || res.status === 404 || res.status === 405) return false;
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.payUrl) {
      /* o carrinho só é esvaziado quando o pagamento for concluído */
      if (submitBtn) submitBtn.textContent = tc('co.opening');
      location.href = data.payUrl;
      return true;
    }
    if (res.ok && data.number) {
      cart.clear();
      try { localStorage.setItem('mekie-code-applied', ''); } catch {}
      location.href = `${localPath('/encomenda-recebida/')}?n=${encodeURIComponent(data.number)}&t=${encodeURIComponent(money(data.total))}${data.paid ? '&pago=1' : ''}`;
      return true;
    }
    if (data.field === 'code') codeError(data.error);
    else if (data.field === 'gift') { gift = { code: '', balance: 0, verified: false }; say(giftMsg, data.error, true); render(cart.lines); giftInput.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
    else { coError.hidden = false; coError.textContent = data.error || tc('co.error'); }
    return true;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const email = String(f.get('email') || '');
    coError.hidden = true;
    if (submitBtn) submitBtn.disabled = true;
    const handled = await sendToCrm(f).finally(() => { if (submitBtn) submitBtn.disabled = false; });
    if (handled) return;

    /* O código de boas-vindas é de quem subscreveu com este email e só vale uma vez */
    if (applied && newsletter.hasWebhook()) {
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await newsletter.check(email);
        if (res.status !== 'unknown' && !res.subscribed) {
          return codeError(tc('co.welcomeOnly', { code: CODE }));
        }
        if (res.used) return codeError(tc('co.welcomeUsed', { code: CODE }));
      } catch {
        /* sem resposta do webhook: segue e confirmamos à mão */
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    const lines = cart.lines;
    const { sub, disc, ship, giftUsed, total } = totals();
    const physical = cart.hasPhysical;
    const body = [
      'Olá Mekie! Quero fazer esta encomenda:',
      '',
      ...lines.map((l) => `• ${l.qty}x ${l.name}, ${l.custom || l.color}${l.size ? `, tamanho ${l.size}` : ''}: ${money(l.qty * l.price)}${made(l) ? ` (${made(l)} por encomenda, ${l.madeToOrderDays} dias úteis)` : ''}`),
      '',
      `Subtotal: ${money(sub)}`,
      disc ? `Desconto ${applied}: -${money(disc)}` : '',
      physical ? `Envio (${f.get('pais')}): ${ship === 0 ? 'grátis' : money(ship)}` : 'Envio: cartão presente por email',
      gift.code ? `Cartão presente ${gift.code}: ${gift.verified ? `-${money(giftUsed)}` : 'saldo por confirmar'}` : '',
      `Total: ${money(total)}`,
      '',
      `Nome: ${f.get('nome')} ${f.get('apelido')}`,
      `Email: ${f.get('email')}`,
      `Telemóvel: ${f.get('telefone')}`,
      physical ? `Morada: ${f.get('morada')}, ${f.get('codigo_postal')} ${f.get('localidade')} (${f.get('pais')})` : '',
      f.get('nif') ? `NIF: ${f.get('nif')}` : '',
      f.get('notas') ? `Notas: ${f.get('notas')}` : '',
    ].filter((x, i, a) => x !== '' || a[i - 1] !== '').join('\n');
    if (applied) newsletter.redeem(email, lines.map((l) => `${l.qty}x ${l.name} ${l.color}`).join(', ')).catch(() => {});
    window.location.href = `mailto:${EMAIL}?subject=${encodeURIComponent('Nova encomenda no site Mekie')}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .co { padding-top: clamp(32px, 5vw, 64px); padding-bottom: clamp(56px, 8vw, 110px); }
  .co__cancel { margin: -20px 0 24px; }
  .co__title { font-size: clamp(32px, 4vw, 52px); text-transform: uppercase; margin: 0 0 36px; }
  .co__empty { display: grid; gap: 18px; justify-items: start; }
  .co__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .co__grid[hidden] { display: none; }
  .co__form { display: grid; gap: 26px; }
  .co__form fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; }
  .co__form legend { font-size: 11px; margin-bottom: 12px; }
  .co__ship { display: grid; gap: 10px; }
  .co__ship[hidden] { display: none; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .co__terms { display: flex; gap: 10px; font-size: 13px; align-items: flex-start; }
  .co__terms input { margin-top: 3px; }
  .co__submit { min-height: 52px; }
  .co__code { display: grid; grid-template-columns: 1fr auto; gap: 10px; }
  .co__code .pill { min-height: 46px; }
  .co__code-msg { margin: 0; font-size: 12.5px; color: var(--accent); }
  .co__code-msg.is-error { color: var(--sale); }
  .co__hint { margin: -2px 0 0; font-size: 12px; color: var(--ink-soft); }
  .co__note { margin: -8px 0 0; font-size: 12.5px; color: var(--ink-soft); }
  .co__summary { background: var(--surface); padding: 28px; position: sticky; top: 130px; }
  .co__summary > .eyebrow { margin: 0 0 18px; font-size: 11px; }
  .co__lines { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 14px; }
  .co__lines :global(li) { display: grid; grid-template-columns: 64px 1fr auto; gap: 14px; align-items: center; position: relative; font-size: 13.5px; }
  .co__lines :global(img) { width: 64px; height: 80px; object-fit: contain; background: var(--bg); }
  .co__lines :global(.q) { position: absolute; left: 50px; top: -6px; background: var(--ink); color: #fff; border-radius: 999px; font-size: 10px; min-width: 18px; height: 18px; display: grid; place-items: center; }
  .co__lines :global(p) { margin: 0; }
  .co__lines :global(small) { color: var(--ink-soft); }
  .co__row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; border-top: 1px solid var(--line); }
  .co__total { font-size: 16px; padding-top: 14px; }
  @media (max-width: 900px) {
    .co__grid { grid-template-columns: 1fr; }
    .co__summary { position: static; order: -1; }
  }
</style>
