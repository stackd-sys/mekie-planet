---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { blogPosts, formatDate, type Post } from '../../data/blog';
import { site } from '../../data/site';
import { breadcrumbLd } from '../../data/seo';

export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const url = new URL(`/blog/${post.slug}/`, site.url).href;
const others = blogPosts.filter((p) => p.slug !== post.slug);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  image: new URL(post.image, site.url).href,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: 'pt-PT',
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': new URL('/#org', site.url).href },
};
---
<Base title={post.title} description={post.description} image={post.image} ogType="article">
  <meta slot="head" property="article:published_time" content={post.date} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd([{ name: 'Início', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: post.title, path: `/blog/${post.slug}/` }]))} />

  <article class="container art">
    <nav class="eyebrow art__crumbs" aria-label="Caminho"><a href="/blog/">Blog</a></nav>
    <h1 class="display art__title">{post.title}</h1>
    <p class="eyebrow art__date"><time datetime={post.date}>{formatDate(post.date)}</time></p>
    <figure class="art__hero">
      <Img src={post.image} alt={post.imageAlt} width="1200" height="800" sizes="(max-width: 820px) 100vw, 760px" loading="eager" fetchpriority="high" />
    </figure>
    <div class="art__body">
      {post.body.map((b) =>
        typeof b === 'string' ? <p set:html={b} />
        : 'h' in b ? <h2>{b.h}</h2>
        : 'list' in b ? <ul>{b.list.map((li) => <li set:html={li} />)}</ul>
        : <figure><Img src={b.img} alt={b.alt} width="1200" height="800" sizes="(max-width: 820px) 100vw, 760px" loading="lazy" /></figure>
      )}
    </div>
    <div class="art__cta">
      <a href="/loja/" class="pill">Ver a loja</a>
    </div>
  </article>

  {others.length > 0 && (
    <section class="container more">
      <h2 class="eyebrow more__title">Mais no blog</h2>
      <ul>
        {others.map((o) => (
          <li><a href={`/blog/${o.slug}/`}><span class="eyebrow">{formatDate(o.date)}</span>{o.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .art { max-width: 760px; padding-top: clamp(40px, 6vw, 80px); }
  .art__crumbs { font-size: 10.5px; margin: 0; }
  .art__crumbs a { color: var(--ink-soft); text-decoration: none; }
  .art__crumbs a:hover { color: var(--ink); }
  .art__title { font-size: clamp(30px, 4.4vw, 52px); margin: 12px 0 14px; }
  .art__date { font-size: 10.5px; color: var(--ink-soft); margin: 0 0 28px; }
  .art__hero { margin: 0 0 36px; aspect-ratio: 3 / 2; overflow: hidden; background: #e7e7e5; }
  .art__hero :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .art__body h2 { font-family: var(--font-display); font-weight: 600; font-size: clamp(20px, 2vw, 24px); margin: 36px 0 10px; }
  .art__body p, .art__body li { font-size: 16px; line-height: 1.8; color: #3a3a3a; margin: 0 0 14px; }
  .art__body ul { padding-left: 20px; margin: 0 0 16px; }
  .art__body li { margin-bottom: 6px; }
  .art__body :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .art__body figure { margin: 24px 0; }
  .art__body figure :global(img) { width: 100%; height: auto; display: block; }
  .art__cta { margin: 36px 0 0; }
  .more { max-width: 760px; padding-top: 48px; padding-bottom: clamp(56px, 8vw, 110px); }
  .more__title { font-size: 12px; font-weight: 600; border-top: 1px solid var(--ink); padding-top: 20px; margin: 0 0 8px; }
  .more ul { list-style: none; margin: 0; padding: 0; }
  .more li a { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: 18px; font-weight: 600; }
  .more li a span { font-family: var(--font-body); font-size: 10.5px; color: var(--ink-soft); font-weight: 400; }
  .more li a:hover { text-decoration: underline; }
</style>
