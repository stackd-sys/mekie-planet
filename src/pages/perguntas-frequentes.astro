---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { faqGroups } from '../data/faq';
import { breadcrumbLd } from '../data/seo';

const plain = (html: string) => html.replace(/<[^>]+>/g, '');
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((g) =>
    g.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
  ),
};
---
<Base title="Perguntas Frequentes" description="Envios, portes, tamanhos, trocas, devoluções, pagamento e cartão presente. As respostas às perguntas que mais nos fazem.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd([{ name: 'Início', path: '/' }, { name: 'Perguntas Frequentes', path: '/perguntas-frequentes/' }]))} />

  <section class="container faq">
    <h1 class="display faq__title">Perguntas frequentes</h1>
    <p class="faq__lead">Não encontras o que procuras? Escreve-nos para <a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a> ou no <a class="link-underline" href={site.instagram} target="_blank" rel="noopener">Instagram</a>.</p>

    <nav class="faq__nav" aria-label="Temas">
      {faqGroups.map((g, i) => <a href={`#tema-${i + 1}`} class="faq__chip eyebrow">{g.title}</a>)}
    </nav>

    {faqGroups.map((g, i) => (
      <div class="faq__group" id={`tema-${i + 1}`}>
        <h2 class="eyebrow faq__group-title">{g.title}</h2>
        {g.items.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <div class="faq__answer" set:html={f.a} />
          </details>
        ))}
      </div>
    ))}
  </section>
</Base>

<style>
  .faq { max-width: 820px; padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(56px, 8vw, 110px); }
  .faq__title { font-size: clamp(32px, 4.4vw, 56px); text-transform: uppercase; margin: 0 0 14px; }
  .faq__lead { margin: 0 0 28px; font-size: 15px; line-height: 1.6; color: var(--ink-soft); }
  .faq__nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; }
  .faq__chip { font-size: 10.5px; padding: 9px 14px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); text-decoration: none; }
  .faq__chip:hover { border-color: var(--ink); }
  .faq__group { padding-top: 28px; scroll-margin-top: 24px; }
  .faq__group-title { font-size: 12px; font-weight: 600; margin: 0 0 6px; }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; font-size: 16px; font-weight: 500; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; font-weight: 400; font-size: 18px; line-height: 1; flex: none; }
  .faq__item[open] summary::after { content: '\2212'; }
  .faq__answer { padding: 0 0 20px; font-size: 15px; line-height: 1.75; color: #3a3a3a; max-width: 680px; }
  .faq__answer :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
