---
import Base from '../layouts/Base.astro';
import { legalPages, type LegalPage } from '../data/legal';

export function getStaticPaths() {
  return legalPages.map((page) => ({ params: { legal: page.slug }, props: { page } }));
}
interface Props { page: LegalPage }
const { page } = Astro.props;
---
<Base title={page.title}>
  <article class="container legal">
    <p class="eyebrow legal__kicker">Informação legal</p>
    <h1 class="display legal__title">{page.title}</h1>
    {page.sections.map((s) => (
      <section>
        {s.heading && <h2 class="eyebrow">{s.heading}</h2>}
        {s.body.map((b) => <p>{b}</p>)}
      </section>
    ))}
  </article>
</Base>

<style>
  .legal { max-width: 760px; padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(56px, 8vw, 110px); }
  .legal__kicker { font-size: 10.5px; color: var(--ink-soft); margin: 0; }
  .legal__title { font-size: clamp(30px, 4vw, 48px); margin: 12px 0 40px; }
  .legal h2 { font-size: 12px; font-weight: 600; margin: 36px 0 12px; }
  .legal p { margin: 0 0 10px; font-size: 15px; line-height: 1.75; color: #3a3a3a; }
</style>
