---
import Base from '../../layouts/Base.astro';
import Collection from '../../components/Collection.astro';
import { site } from '../../data/site';
import { categories, products, productsIn, lowStock, type Product } from '../../data/products';

export function getStaticPaths() {
  const special = [
    {
      slug: 'ultimas-unidades',
      title: 'Últimas unidades',
      intro: 'Peças com poucas unidades em stock.',
      items: lowStock(),
    },
  ];
  return [
    ...special.map((s) => ({ params: { categoria: s.slug }, props: { title: s.title, intro: s.intro, items: s.items } })),
    ...categories.map((c) => ({
      params: { categoria: c.slug },
      props: { title: c.name, intro: undefined, items: productsIn(c.slug) },
    })),
  ];
}

interface Props { title: string; intro?: string; items: Product[] }
const { title, intro, items } = Astro.props;
const { categoria } = Astro.params;
---
<Base title={title} description={`${title} da Mekie Planet. Envio em ${site.deliveryDays} dias úteis, grátis acima de ${site.freeShippingFrom}€.`}>
  <Collection title={title} intro={intro} products={items} current={categoria!} />
</Base>
