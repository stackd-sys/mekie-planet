---
import Base from '../../layouts/Base.astro';
import Collection from '../../components/Collection.astro';
import { site } from '../../data/site';
import { categories, productsIn, lowStock, type Product } from '../../data/products';
import { breadcrumbLd, categoryTrail } from '../../data/seo';

export function getStaticPaths() {
  const special = [
    {
      slug: 'ultimas-unidades',
      title: 'Últimas unidades',
      seoTitle: 'Últimas unidades',
      intro: 'Peças com poucas unidades em stock. Quando acabam, podem não voltar.',
      items: lowStock(),
    },
  ];
  return [
    ...special.map((s) => ({ params: { categoria: s.slug }, props: { title: s.title, seoTitle: s.seoTitle, intro: s.intro, items: s.items } })),
    ...categories.map((c) => ({
      params: { categoria: c.slug },
      props: { title: c.name, seoTitle: c.seoTitle, intro: c.intro, items: productsIn(c.slug) },
    })),
  ];
}

interface Props { title: string; seoTitle: string; intro: string; items: Product[] }
const { title, seoTitle, intro, items } = Astro.props;
const { categoria } = Astro.params;
const trail = categoria === 'ultimas-unidades'
  ? [{ name: 'Início', path: '/' }, { name: 'Loja', path: '/loja/' }, { name: title, path: '/loja/ultimas-unidades/' }]
  : categoryTrail(categoria!);
---
<Base title={seoTitle} description={`${intro} Envio CTT para Portugal, grátis acima de ${site.freeShippingFrom}€.`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd(trail))} />
  <Collection title={title} intro={intro} products={items} current={categoria!} />
</Base>
