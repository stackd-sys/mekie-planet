---
import Base from '../../layouts/Base.astro';
import Carousel from '../../components/Carousel.astro';
import Img from '../../components/Img.astro';
import { products, discount, fullName, variantsOf, cartInfo, totalStock, isSoldOut, yarnColors, weightOf, type Product } from '../../data/products';
import { site, formatPrice } from '../../data/site';
import { shipping, shippingCost } from '../../data/shipping';
import { reviewsOf, ratingOf } from '../../data/reviews';
import Stars from '../../components/Stars.astro';
import Icon from '../../components/Icon.astro';
import { productLd, breadcrumbLd, categoryTrail, productSummary } from '../../data/seo';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
interface Props { product: Product }
const { product: p } = Astro.props;
const reviews = reviewsOf(p);
const rating = ratingOf(p);
const off = discount(p);
const variants = variantsOf(p);
const related = [
  ...products.filter((o) => o.collection && o.collection === p.collection && o.slug !== p.slug),
  ...products.filter((o) => o.category === p.category && o.slug !== p.slug && o.collection !== p.collection),
  ...products.filter((o) => o.category !== p.category && o.collection !== p.collection),
].slice(0, 8);
const cartData = { ...cartInfo(p), sizeNotes: p.sizeNotes };
const total = totalStock(p);
const soldOut = isSoldOut(p);
/* Tamanhos esgotados (ou o produto todo) para o "Avisa-me quando voltar" */
const outSizes = p.sizes ? p.sizes.filter((s) => (soldOut ? true : !!p.sizeStock && !p.sizeStock[s])) : [];
/* Dias úteis até à entrega em Portugal: peças por encomenda demoram mais */
const etaDays = p.customizable || (p.madeToOrderDays && !(p.stock && p.stock > 0)) ? p.madeToOrderDays! : site.deliveryDays;
const canNotify = !p.customizable && !p.madeToOrderDays && (soldOut || outSizes.length > 0);
const payments = ['MB WAY', 'Multibanco', 'Visa', 'Mastercard', 'Apple Pay', 'Google Pay'];
const trail = [...categoryTrail(p.category), { name: fullName(p), path: `/produto/${p.slug}/` }];
const yarnLabel = (c: (typeof yarnColors)[number]) => (c.code ? `${c.code} ${c.name}` : c.name);
/* Pré-visualização do scrunchie: folhos à volta de um aro */
const isCutout = (src: string) => src.includes('/products/') && /-1\.webp$/.test(src);
---
<Base title={fullName(p)} description={`${productSummary(p)} ${formatPrice(p.price)}. Envio CTT para Portugal e União Europeia.`} image={p.images[1] ?? p.images[0]} ogType="product">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productLd(p))} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd(trail))} />
  <meta slot="head" property="product:price:amount" content={p.price.toFixed(2)} />
  <meta slot="head" property="product:price:currency" content="EUR" />

  <div class="pdp">
    <div class="gallery" data-gallery>
      <div class="gallery__track" data-track>
        {p.images.map((src, i) => (
          <figure class:list={['gallery__item', { 'gallery__item--lead': i === 0, 'gallery__item--cover': !isCutout(src) }]} data-slide={i}>
            <Img src={src} sizes={i === 0 ? '(max-width: 900px) 100vw, 58vw' : '(max-width: 900px) 100vw, 29vw'} alt={`${p.name} ${p.color}, imagem ${i + 1} de ${p.images.length}`} width="1000" height="1250" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
          </figure>
        ))}
      </div>
      {p.images.length > 1 && (
        <div class="gallery__dots" aria-hidden="true">
          {p.images.map((_, i) => <span class:list={{ 'is-active': i === 0 }} data-dot={i}></span>)}
        </div>
      )}
      <p class="gallery__ref eyebrow">Ref. {p.id}</p>
    </div>

    <div class="info">
      <h1 class="info__title">{p.name}</h1>
      {rating && (
        <a href="#opinioes" class="info__rating">
          <Stars rating={rating.value} size={13} />
          <span>{rating.count === 1 ? '1 opinião' : `${rating.count} opiniões`}</span>
        </a>
      )}
      <p class="price info__price">
        {off > 0 && <del><span class="sr-only">Preço original </span>{formatPrice(p.regularPrice)}</del>}
        {off > 0 ? <ins><span class="sr-only">Preço atual </span>{formatPrice(p.price)}</ins> : <span>{formatPrice(p.price)}</span>}
        {off > 0 && <span class="info__off">-{off}%</span>}
      </p>
      <p class="info__tax">IVA incluído. Portes calculados no checkout.</p>
      {p.customizable ? (
        <div class="info__order">
          <p><strong>Feito à mão por encomenda,</strong> com as cores que escolheres. Entrega em {p.madeToOrderDays} dias úteis.</p>
        </div>
      ) : p.madeToOrderDays ? (
        <div class="info__order">
          <p><strong>{p.stock === 1 ? '1 unidade pronta a enviar.' : `${p.stock ?? 0} unidades prontas a enviar.`}</strong> Depois disso fazemos por encomenda, com entrega em {p.madeToOrderDays} dias úteis.</p>
          <a href="/produto/scrunchie-personalizado/" class="link-underline">Queres outras cores? Personaliza o teu</a>
        </div>
      ) : soldOut ? (
        <p class="info__stock info__stock--out">Esgotado</p>
      ) : !p.sizeStock && total !== undefined && total <= 3 && (
        <p class="info__stock"><span class="info__dot"></span>{total === 1 ? 'Só resta 1 unidade' : `Só restam ${total} unidades`}</p>
      )}

      {!p.customizable && <div class="opt">
        <p class="opt__label">Cor: <span>{p.color}</span></p>
        <div class="swatches">
          {variants.map((v) => (
            <a href={`/produto/${v.slug}/`} class:list={['swatch', { 'is-active': v.slug === p.slug }]} aria-label={`Cor ${v.color}`} aria-current={v.slug === p.slug ? 'page' : undefined} title={v.color}>
              <img src={v.images[0].replace('.webp', '-sm.webp')} alt="" width="64" height="64" loading="lazy" />
            </a>
          ))}
        </div>
      </div>}

      <form class="buy" data-buy data-product={JSON.stringify(cartData)} novalidate>
        {p.customizable && (
          <div class="custom">
            <figure class="custom__preview">
              <canvas width="640" height="640" data-preview data-map="/images/products/scrunchie-personalizado-mapa.webp" role="img" aria-label="Pré-visualização do scrunchie com as cores escolhidas"></canvas>
              <figcaption>Pré-visualização com as tuas cores</figcaption>
            </figure>
            {[['main', 'Cor do corpo'], ['edge', 'Cor do rebordo']].map(([name, label]) => (
              <fieldset class="opt">
                <legend class="opt__label">{label}: <span data-pick-label={name}>escolhe uma cor</span></legend>
                <div class="yarns">
                  {yarnColors.map((c) => (
                    <label class="yarn" title={yarnLabel(c)}>
                      <input type="radio" name={name} value={yarnLabel(c)} data-hex={c.hex} />
                      <span style={`--c:${c.hex}`}><span class="sr-only">{yarnLabel(c)}</span></span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
            <p class="custom__note">Fio Rosários 4 Bio Love, 100% algodão orgânico. As cores no ecrã podem variar ligeiramente.</p>
          </div>
        )}
        {p.sizes ? (
          <fieldset class="opt">
            <legend class="opt__label">Tamanho: <span data-size-label>escolhe o teu tamanho</span></legend>
            <div class="sizes">
              {p.sizes.map((s) => {
                const out = !!p.sizeStock && !p.sizeStock[s];
                return (
                  <label class:list={['size', { 'is-out': out }]} title={out ? 'Esgotado. Toca para seres avisado quando voltar' : undefined}>
                    <input type="radio" name="size" value={s} disabled={out} />
                    <span>{s}{out && <span class="sr-only"> (esgotado)</span>}</span>
                  </label>
                );
              })}
            </div>
            <p class="info__stock size-stock" data-size-stock hidden><span class="info__dot"></span><span data-size-stock-text></span></p>
            <p class="size-note" data-size-note hidden></p>
            <a href="/contactos/" class="opt__help link-underline">Dúvidas com o tamanho? Fala connosco</a>
          </fieldset>
        ) : (
          <p class="opt__label">Tamanho: <span>Único</span></p>
        )}

        <p class="buy__error" role="alert" hidden>{p.customizable ? 'Escolhe as duas cores para continuar.' : 'Escolhe um tamanho para continuar.'}</p>
        <button type="submit" class="pill pill--accent pill--block buy__btn" data-buy-btn disabled={soldOut}>
          {soldOut ? 'Esgotado' : 'Adicionar ao carrinho'}
        </button>
      </form>

      {!soldOut && (
        <p class="eta" data-eta={etaDays} hidden>
          <Icon name="truck" size={18} />
          <span>Encomenda hoje e recebe até <strong data-eta-date></strong> em Portugal.</span>
        </p>
      )}

      {canNotify && (
        <div class="notify" data-notify data-name={fullName(p)}>
          <button type="button" class="notify__toggle link-underline" data-notify-toggle aria-expanded={soldOut ? 'true' : 'false'} hidden={soldOut}>
            Esgotado no teu tamanho? Avisa-me quando voltar
          </button>
          <form class="notify__form" data-notify-form novalidate hidden={!soldOut}>
            <p class="notify__title">Avisa-me quando voltar</p>
            <div class="notify__row">
              {outSizes.length > 0 && (
                <select class="field notify__size" name="size" aria-label="Tamanho">
                  {outSizes.map((s) => <option value={s}>{s}</option>)}
                </select>
              )}
              <input class="field" type="email" name="email" placeholder="O teu email" required autocomplete="email" aria-label="O teu email" />
            </div>
            <button type="submit" class="pill pill--block">Avisar-me</button>
            <p class="notify__fine">Só usamos o teu email para te avisar desta peça, uma vez.</p>
            <p class="notify__msg" role="status" data-notify-msg hidden></p>
          </form>
        </div>
      )}

      <ul class="pay" aria-label="Métodos de pagamento">
        {payments.map((m) => <li>{m}</li>)}
      </ul>
      <p class="pay__note">Pagamento seguro · MB WAY, Multibanco, cartão, Apple Pay e Google Pay</p>

      <ul class="perks eyebrow">
        <li>Envio grátis em Portugal acima de {site.freeShippingFrom}€</li>
        <li>Devoluções em 14 dias</li>
        <li>Envio em {site.deliveryDays} dias úteis via CTT</li>
        <li>Portugal, ilhas e União Europeia</li>
      </ul>

      <div class="acc">
        <details open>
          <summary class="eyebrow">Descrição</summary>
          <div class="acc__body">
            {p.description && <p>{p.description}</p>}
            {p.details && (
              <ul>{p.details.features.map((f) => <li>{f}</li>)}</ul>
            )}
            <ul>
              <li>Cor: {p.color}</li>
              <li>Tamanhos: {p.sizes ? p.sizes.join(', ') : 'tamanho único'}</li>
            </ul>
          </div>
        </details>
        {p.details && (p.details.composition.length > 0 || p.details.care) && (
          <details>
            <summary class="eyebrow">Composição e cuidados</summary>
            <div class="acc__body">
              {p.details.composition.length > 0 && (
                <>
                  <p class="acc__label">Composição</p>
                  <ul>{p.details.composition.map((c) => <li>{c}</li>)}</ul>
                </>
              )}
              {p.details.care && (
                <>
                  <p class="acc__label">Cuidados</p>
                  <ul>{p.details.care.map((c) => <li>{c}</li>)}</ul>
                </>
              )}
            </div>
          </details>
        )}
        <details>
          <summary class="eyebrow">Envios e devoluções</summary>
          <div class="acc__body">
            <p>Enviamos pelos CTT para Portugal Continental, Açores, Madeira e União Europeia.</p>
            <p>Portugal, Açores e Madeira: {formatPrice(shippingCost('pt', 0, weightOf(p)))} para esta peça, grátis acima de {shipping.pt.freeFrom}€. Entrega em {shipping.pt.days}.</p>
            <p>União Europeia: {formatPrice(shippingCost('eu', 0, weightOf(p)))} para esta peça. Entrega em {shipping.eu.days}.</p>
            <p>Com mais peças o valor muda conforme o peso. Vê a <a href="/politica-de-envios-e-entregas/" class="link-underline">tabela de portes</a>.</p>
            <p>Tens 14 dias após a receção para devolver, sem indicar o motivo. O artigo deve estar nas condições originais, sem sinais de uso e com as etiquetas intactas.</p>
            <p><a class="link-underline" href="/politica-de-envios-e-entregas/">Política de envios</a> · <a class="link-underline" href="/politica-de-devolucoes-e-reembolsos/">Política de devoluções</a></p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="sticky-buy" data-sticky hidden>
    <img src={p.images[0].replace('.webp', '-sm.webp')} alt="" width="44" height="55" />
    <div class="sticky-buy__txt">
      <p>{p.name}</p>
      <p class="price">{off > 0 && <del>{formatPrice(p.regularPrice)}</del>}{off > 0 ? <ins>{formatPrice(p.price)}</ins> : <span>{formatPrice(p.price)}</span>}</p>
    </div>
    <button type="button" class="pill pill--accent" data-sticky-btn disabled={soldOut}>{soldOut ? 'Esgotado' : 'Adicionar'}</button>
  </div>

  {reviews.length > 0 && rating && (
    <section class="section reviews" id="opinioes" aria-labelledby="reviews-title">
      <div class="container">
        <div class="reviews__head">
          <h2 id="reviews-title" class="section-title related__title">Opiniões</h2>
          <p class="reviews__score"><Stars rating={rating.value} size={15} /> <span>{String(rating.value).replace('.', ',')} em 5 · {rating.count === 1 ? '1 opinião' : `${rating.count} opiniões`}</span></p>
        </div>
        <ul class="reviews__list">
          {reviews.map((rv) => (
            <li class="review">
              <Stars rating={rv.rating} size={12} />
              <p class="review__text">{rv.text}</p>
              <p class="review__author eyebrow">{rv.author}</p>
            </li>
          ))}
        </ul>
        <p class="reviews__note">Opiniões de quem já usa as nossas peças.</p>
      </div>
    </section>
  )}

  <section class="section related">
    <div class="container">
      <h2 class="section-title related__title">Continua a explorar</h2>
      <Carousel products={related} label="Produtos relacionados" />
    </div>
  </section>
</Base>

<script>
  import { cart } from '../../scripts/cart';
  import { openCart } from '../../scripts/ui';
  import { track as trackEvent, consentSettled } from '../../scripts/consent';
  import * as newsletter from '../../scripts/newsletter';
  import { deliveryBy, formatDay } from '../../scripts/eta';

  /* Data de entrega estimada, calculada no dia em que a página é aberta */
  const eta = document.querySelector<HTMLElement>('[data-eta]');
  if (eta) {
    eta.querySelector('[data-eta-date]')!.textContent = formatDay(deliveryBy(Number(eta.dataset.eta)));
    eta.hidden = false;
  }

  /* Avisa-me quando voltar */
  const notify = document.querySelector<HTMLElement>('[data-notify]');
  if (notify) {
    const nForm = notify.querySelector<HTMLFormElement>('[data-notify-form]')!;
    const toggle = notify.querySelector<HTMLButtonElement>('[data-notify-toggle]')!;
    const nMsg = notify.querySelector<HTMLElement>('[data-notify-msg]')!;
    const sizeSel = nForm.querySelector<HTMLSelectElement>('[name=size]');
    const open = (size?: string) => {
      nForm.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (size && sizeSel) sizeSel.value = size;
      nForm.querySelector<HTMLInputElement>('[name=email]')!.focus({ preventScroll: true });
      nForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    toggle.addEventListener('click', () => (nForm.hidden ? open() : ((nForm.hidden = true), toggle.setAttribute('aria-expanded', 'false'))));
    /* clicar num tamanho esgotado abre o aviso com esse tamanho */
    document.querySelectorAll<HTMLElement>('.size.is-out').forEach((el) =>
      el.addEventListener('click', () => open(el.querySelector('input')?.value)),
    );
    nForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailEl = nForm.querySelector<HTMLInputElement>('[name=email]')!;
      const email = emailEl.value.trim();
      const show = (text: string, error = false) => { nMsg.hidden = false; nMsg.textContent = text; nMsg.classList.toggle('is-error', error); };
      if (!email || !emailEl.checkValidity()) return show('Escreve um email válido.', true);
      const size = sizeSel?.value ?? '';
      const btn = nForm.querySelector<HTMLButtonElement>('[type=submit]')!;
      btn.disabled = true;
      try {
        const res = await newsletter.notify(email, notify.dataset.name || '', size);
        show(res.status === 'exists'
          ? `Já tínhamos o teu pedido${size ? ` para o ${size}` : ''}. Avisamos-te em ${email}.`
          : `Combinado. Avisamos-te em ${email} quando ${size ? `o ${size} voltar` : 'voltar'}.`);
        emailEl.value = '';
      } catch {
        show('Não conseguimos guardar o pedido. Tenta outra vez daqui a pouco.', true);
      } finally {
        btn.disabled = false;
      }
    });
  }

  /* Galeria: pontos no telemóvel */
  const track = document.querySelector<HTMLElement>('[data-track]');
  const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
  track?.addEventListener('scroll', () => {
    /* as fotos ocupam 86% da largura, por isso a seguinte espreita; no fim do scroll é sempre a última */
    const step = (track.firstElementChild as HTMLElement | null)?.offsetWidth || track.clientWidth;
    const end = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    const i = end ? dots.length - 1 : Math.round(track.scrollLeft / step);
    dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
  }, { passive: true });

  /* Compra */
  const form = document.querySelector<HTMLFormElement>('[data-buy]');
  if (form) {
    const product = JSON.parse(form.dataset.product!);

    /* Scrunchie personalizado: pinta a fotografia com as cores escolhidas.
       O mapa guarda a sombra do crochet (vermelho), a zona do rebordo (verde) e o recorte (alfa). */
    const picked: Record<string, string> = { main: '#de5378', edge: '#d8c0cc' };
    const canvas = form.querySelector<HTMLCanvasElement>('[data-preview]');
    let mapData: ImageData | null = null;
    const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const paint = () => {
      if (!canvas || !mapData) return;
      const ctx = canvas.getContext('2d')!;
      const out = ctx.createImageData(mapData.width, mapData.height);
      const src = mapData.data, dst = out.data;
      const [mr, mg, mb] = hex(picked.main), [er, eg, eb] = hex(picked.edge);
      for (let i = 0; i < src.length; i += 4) {
        const shade = src[i] / 128, w = src[i + 1] / 255;
        dst[i] = (mr + (er - mr) * w) * shade;
        dst[i + 1] = (mg + (eg - mg) * w) * shade;
        dst[i + 2] = (mb + (eb - mb) * w) * shade;
        dst[i + 3] = src[i + 3];
      }
      ctx.putImageData(out, 0, 0);
    };
    if (canvas) {
      const map = new Image();
      map.onload = () => {
        const tmp = document.createElement('canvas');
        tmp.width = canvas.width = map.naturalWidth;
        tmp.height = canvas.height = map.naturalHeight;
        const tctx = tmp.getContext('2d', { willReadFrequently: true })!;
        tctx.drawImage(map, 0, 0);
        mapData = tctx.getImageData(0, 0, tmp.width, tmp.height);
        paint();
      };
      map.src = canvas.dataset.map!;
    }
    const item = (size?: string) => ({ id: product.id, name: product.customizable ? product.name : `${product.name} ${product.color}`, price: product.price, variant: size });
    const viewed = () => trackEvent('view_item', [item()]);
    if (consentSettled()) viewed();
    else document.addEventListener('mekie:consent', viewed, { once: true });
    const error = form.querySelector<HTMLElement>('.buy__error')!;
    const sizeLabel = form.querySelector<HTMLElement>('[data-size-label]');
    const btn = form.querySelector<HTMLButtonElement>('[data-buy-btn]')!;
    const hasSizes = !!form.querySelector('input[name=size]');

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'main' || t.name === 'edge') {
        error.hidden = true;
        const label = form.querySelector<HTMLElement>(`[data-pick-label=${t.name}]`);
        if (label) label.textContent = t.value;
        picked[t.name] = t.dataset.hex!;
        paint();
      }
      if (t.name === 'size') {
        error.hidden = true;
        if (sizeLabel) sizeLabel.textContent = t.value;
        const left = product.sizeStock?.[t.value];
        const stockBox = form.querySelector<HTMLElement>('[data-size-stock]');
        if (stockBox) {
          stockBox.hidden = !(left > 0 && left <= 3);
          stockBox.querySelector('[data-size-stock-text]')!.textContent =
            left === 1 ? `Só resta 1 unidade em ${t.value}` : `Só restam ${left} unidades em ${t.value}`;
        }
        const note = form.querySelector<HTMLElement>('[data-size-note]');
        if (note) {
          note.textContent = product.sizeNotes?.[t.value] ?? '';
          note.hidden = !note.textContent;
        }
      }
    });

    const add = () => {
      const data = new FormData(form);
      const size = (data.get('size') as string | null) ?? undefined;
      const main = data.get('main') as string | null;
      const edge = data.get('edge') as string | null;
      const isCustom = !!form.querySelector('input[name=main]');
      if (isCustom && (!main || !edge)) {
        error.hidden = false;
        form.querySelector('.custom')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (hasSizes && !size) {
        error.hidden = false;
        form.querySelector('.sizes')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      const { sizeNotes, ...info } = product;
      cart.add({ ...info, size, ...(isCustom ? { custom: `Corpo ${main}, rebordo ${edge}` } : {}) }, 1);
      trackEvent('add_to_cart', [item(size)]);
      btn.textContent = 'Adicionado ✓';
      setTimeout(() => (btn.textContent = 'Adicionar ao carrinho'), 1600);
      openCart();
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); add(); });
    document.querySelector('[data-sticky-btn]')?.addEventListener('click', add);

    /* Barra fixa no telemóvel quando o botão principal sai do ecrã */
    const sticky = document.querySelector<HTMLElement>('[data-sticky]');
    if (sticky && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        sticky.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0;
      }).observe(btn);
    }
  }
</script>

<style>
  .pdp {
    display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 72px);
    max-width: 1440px; margin: 0 auto;
    padding: clamp(16px, 3vw, 40px) var(--gutter) 0;
  }

  .gallery__track { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .gallery__item { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
