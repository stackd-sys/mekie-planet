---
import Base from '../../layouts/Base.astro';
import Collection from '../../components/Collection.astro';
import { collections, productsInCollection } from '../../data/products';
import { langOf } from '../../i18n';
import { useT } from '../../i18n/ui';
import { trCollection } from '../../i18n/catalog';

export function getStaticPaths() {
  return collections.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}
interface Props { slug: string }
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const col = trCollection(collections.find((c) => c.slug === Astro.props.slug)!, lang);
---
<Base title={t('collection.title', { name: col.name })} description={`${col.intro} ${t('collection.desc', { name: col.name })}`} image={col.image}>
  <Collection title={col.name} intro={col.intro} image={col.image} products={productsInCollection(col.slug)} current={`col-${col.slug}`} />
</Base>
