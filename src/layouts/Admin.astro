---
/* Moldura do CRM: menu lateral e estilos próprios. Nada de estatísticas, publicidade ou pop ups aqui. */
import '@fontsource-variable/inter';
import '@fontsource/syne/600.css';
import { site } from '../data/site';
interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
const admin = Astro.locals.admin ?? '';
type Link = [string, string];
/* menu: ligações soltas e grupos (o título do grupo não é clicável) */
const nav: (Link | { group: string; items: Link[] })[] = [
  ['/admin/', 'Painel'],
  ['/admin/encomendas/', 'Encomendas'],
  ['/admin/clientes/', 'Clientes'],
  ['/admin/produtos/', 'Stock e produtos'],
  ['/admin/devolucoes/', 'Trocas e devoluções'],
  ['/admin/cartoes/', 'Cartões presente'],
  { group: 'Marketing', items: [
    ['/admin/marketing/visitas/', 'Visitas'],
    ['/admin/marketing/google-analytics/', 'Google Analytics'],
    ['/admin/marketing/meta/', 'Meta'],
    ['/admin/marketing/google-ads/', 'Google Ads'],
    ['/admin/codigos/', 'Códigos e links'],
    ['/admin/newsletter/', 'Newsletter e avisos'],
  ] },
];
const links = nav.flatMap((x) => (Array.isArray(x) ? [x] : x.items));
const path = Astro.url.pathname;
/* atalhos da barra de baixo no telemóvel; o resto fica em "Mais" */
const tabs = [['/admin/', 'Painel'], ['/admin/encomendas/', 'Encomendas'], ['/admin/clientes/', 'Clientes'], ['/admin/produtos/', 'Stock']];
const current = links.filter(([href]) => path === href || (href !== '/admin/' && path.startsWith(href))).sort((a, b) => b[0].length - a[0].length)[0]?.[0];
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · CRM Mekie</title>
  <link rel="icon" href="/images/site/icon.png" type="image/png" />
</head>
<body>
  <div class="adm">
    <aside class="adm__side" data-side>
      <div class="adm__head">
        <a href="/admin/" class="adm__logo"><img src="/images/site/logo.png" alt="Mekie" width="96" height="32" /> <span>CRM</span></a>
        <button type="button" class="adm__toggle" data-menu aria-expanded="false" aria-controls="adm-nav">Menu</button>
      </div>
      <nav id="adm-nav">
        {nav.map((x) => Array.isArray(x)
          ? <a href={x[0]} class:list={{ 'is-on': current === x[0] }}>{x[1]}</a>
          : <><p class="adm__group">{x.group}</p>{x.items.map(([href, label]) => <a href={href} class:list={['adm__sub', { 'is-on': current === href }]}>{label}</a>)}</>)}
      </nav>
      <div class="adm__me">
        <p>{admin}</p>
        <a href={`${site.url}/`} target="_blank">Ver o site</a>
        <form method="post" action="/admin/sair/"><button type="submit">Sair</button></form>
      </div>
    </aside>
    <main class:list={['adm__main', { 'adm__main--wide': wide }]}>
      <slot />
    </main>
  </div>
  <nav class="adm__tabs" aria-label="Atalhos">
    {tabs.map(([href, label]) => <a href={href} class:list={{ 'is-on': current === href }}>{label}</a>)}
    <button type="button" data-menu class:list={{ 'is-on': current && !tabs.some(([h]) => h === current) }}>Mais</button>
  </nav>
  <script is:inline>
    /* menu do telemóvel */
    (() => {
      const side = document.querySelector('[data-side]');
      document.querySelectorAll('[data-menu]').forEach((b) => b.addEventListener('click', () => {
        const open = side.classList.toggle('is-open');
        document.querySelectorAll('[data-menu][aria-expanded]').forEach((x) => x.setAttribute('aria-expanded', String(open)));
        document.documentElement.classList.toggle('menu-open', open);
        document.querySelector('.adm__toggle').textContent = open ? 'Fechar' : 'Menu';
      }));
      /* tabelas: cada coluna ganha o seu nome, para no telemóvel as linhas virarem cartões */
      document.querySelectorAll('table').forEach((t) => {
        const heads = [...t.querySelectorAll('thead th')].map((th) => th.textContent.trim());
        if (!heads.length) return;
        t.classList.add('rt');
        t.querySelectorAll('tbody tr').forEach((tr) => {
          [...tr.children].forEach((td, i) => { if (heads[i]) td.dataset.label = heads[i]; });
          /* a linha toda abre o registo, não só o número */
          const link = tr.querySelector('a.row-link');
          if (link) tr.addEventListener('click', (e) => { if (!e.target.closest('a, button, input, select, textarea, label')) location.href = link.href; });
          if (link) tr.style.cursor = 'pointer';
        });
      });
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #f5f5f4; --surface: #fff; --ink: #1f1f1f; --soft: #5c5c5c; --line: #e2e2df;
    --ok: #1f7a4d; --warn: #9a6200; --info: #1d5c99; --bad: #b3261e;
    --font: 'Inter Variable', Helvetica, Arial, sans-serif; --display: 'Syne', 'Inter Variable', sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 14px; line-height: 1.45; }
  a { color: inherit; }
  h1 { font-family: var(--display); font-weight: 600; font-size: 26px; margin: 0 0 6px; }
  h2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; margin: 28px 0 12px; }
  .sub { color: var(--soft); margin: 0 0 22px; }
  .adm { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }
  .adm__side { background: var(--ink); color: #eee; padding: 22px 16px; position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; gap: 22px; }
  .adm__logo { display: flex; align-items: center; gap: 8px; text-decoration: none; color: #fff; font-size: 12px; letter-spacing: .1em; }
  .adm__logo img { filter: invert(1); height: 26px; width: auto; }
  .adm__side nav { display: grid; gap: 2px; }
  .adm__side nav a { text-decoration: none; padding: 8px 10px; border-radius: 6px; color: #cfcfcf; }
  .adm__side nav a:hover { background: #2c2c2c; color: #fff; }
  .adm__side nav a.is-on { background: #fff; color: var(--ink); }
  .adm__group { margin: 14px 0 4px; padding: 0 10px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #8a8a8a; }
  .adm__side nav a.adm__sub { padding-left: 20px; }
  .adm__me { margin-top: auto; font-size: 12px; color: #aaa; display: grid; gap: 6px; }
  .adm__me p { margin: 0; word-break: break-all; }
  .adm__me button { background: none; border: 0; color: #fff; padding: 0; text-decoration: underline; cursor: pointer; font: inherit; }
  .adm__main { padding: 28px clamp(16px, 3vw, 40px) 60px; max-width: 1180px; width: 100%; min-width: 0; }
  .adm__main--wide { max-width: none; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; min-width: 0; overflow-x: auto; }
  .grid { display: grid; gap: 14px; }
  .kpis { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  .kpi p { margin: 0; color: var(--soft); font-size: 12px; }
  .kpi strong { display: block; font-size: 24px; font-family: var(--display); margin-top: 4px; }
  .kpi small { color: var(--soft); }
  .two { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  table { width: 100%; border-collapse: collapse; background: var(--surface); }
  .table { border: 1px solid var(--line); border-radius: 10px; overflow: auto; background: var(--surface); }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--soft); font-weight: 600; white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  tbody tr:hover { background: #fafaf9; }
  .row-link { text-decoration: none; font-weight: 600; white-space: nowrap; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11.5px; font-weight: 600; background: #eee; white-space: nowrap; }
  .badge.warn { background: #fff1d6; color: var(--warn); }
  .badge.info { background: #e1edf9; color: var(--info); }
  .badge.ok { background: #dff3e8; color: var(--ok); }
  .badge.done { background: #e9e9e6; color: #333; }
  .badge.off { background: #f6e1df; color: var(--bad); }
  form.inline { display: inline; }
  label { display: grid; gap: 4px; font-size: 12px; color: var(--soft); }
  input, select, textarea { font: inherit; color: var(--ink); border: 1px solid #cfcfcb; border-radius: 6px; padding: 8px 10px; background: #fff; min-width: 0; }
  textarea { min-height: 70px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--ink); outline-offset: -1px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; background: var(--ink); color: #fff; border: 0; border-radius: 999px; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; white-space: nowrap; }
  .btn:hover { background: #000; }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .btn.ghost:hover { background: var(--ink); color: #fff; }
  .btn.small { padding: 5px 11px; font-size: 12.5px; }
  .btn.danger { background: var(--bad); }
  .bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin: 0 0 16px; }
  .bar > * { flex: 0 1 auto; min-width: 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
  .tabs a { text-decoration: none; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: #fff; font-size: 12.5px; }
  .tabs a.is-on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .msg { padding: 10px 14px; border-radius: 8px; background: #dff3e8; color: var(--ok); margin: 0 0 16px; }
  .msg.err { background: #f6e1df; color: var(--bad); }
  .muted { color: var(--soft); }
  .empty { padding: 30px; text-align: center; color: var(--soft); }
  .stack { display: grid; gap: 10px; }
  .fields { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  dl.kv { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
  dl.kv dt { color: var(--soft); }
  dl.kv dd { margin: 0; }
  .note { font-size: 12.5px; color: var(--soft); }
  .setup { border-style: dashed; background: #fbfbfa; }
  .setup code { background: #eee; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
  .adm__head { display: contents; }
  .adm__toggle, .adm__tabs { display: none; }
  @media (max-width: 860px) {
    .two { grid-template-columns: minmax(0, 1fr); }
    .adm { grid-template-columns: minmax(0, 1fr); }
    .adm__main { padding: 20px 16px calc(84px + env(safe-area-inset-bottom, 0px)); }
    h1 { font-size: 22px; }

    /* barra de cima: logótipo e menu */
    .adm__side { position: sticky; top: 0; z-index: 30; height: auto; padding: 10px 16px; gap: 0; }
    .adm__head { display: flex; align-items: center; justify-content: space-between; }
    .adm__logo img { height: 22px; }
    .adm__toggle { display: inline-flex; background: none; border: 1px solid #555; color: #fff; border-radius: 999px; padding: 6px 14px; font: inherit; font-size: 13px; cursor: pointer; }
    .adm__side nav, .adm__me { display: none; }
    .adm__side.is-open { position: fixed; inset: 0; overflow-y: auto; padding-bottom: calc(90px + env(safe-area-inset-bottom, 0px)); }
    .adm__side.is-open nav { display: grid; gap: 2px; margin-top: 18px; }
    .adm__side.is-open nav a { padding: 14px 12px; font-size: 16px; border-radius: 8px; }
    .adm__side.is-open nav a.adm__sub { padding-left: 24px; }
    .adm__side.is-open .adm__group { margin-top: 18px; font-size: 12px; }
    .adm__side.is-open .adm__me { display: grid; gap: 10px; margin-top: 24px; font-size: 14px; }
    .menu-open body { overflow: hidden; }

    /* barra de baixo, como numa app */
    .adm__tabs {
      display: grid; grid-template-columns: repeat(5, 1fr);
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      background: var(--ink); padding: 6px 6px calc(6px + env(safe-area-inset-bottom, 0px));
    }
    .adm__tabs a, .adm__tabs button {
      display: grid; place-items: center; min-height: 48px; padding: 0 2px;
      color: #bdbdbd; text-decoration: none; font: inherit; font-size: 12px; font-weight: 600;
      background: none; border: 0; border-radius: 8px; cursor: pointer;
    }
    .adm__tabs .is-on { background: #fff; color: var(--ink); }

    /* tabelas viram cartões: uma linha por registo, com o nome de cada coluna */
    table.rt thead { display: none; }
    table.rt, table.rt tbody, table.rt tr, table.rt td { display: block; width: 100%; }
    table.rt tr { padding: 12px 14px; border-bottom: 1px solid var(--line); }
    table.rt tr:last-child { border-bottom: 0; }
    table.rt td { padding: 5px 0; border: 0; text-align: right; overflow: hidden; }
    table.rt td::before { content: attr(data-label); float: left; margin-right: 14px; color: var(--soft); font-size: 12px; line-height: 2; text-align: left; }
    /* stock por tamanho: os tamanhos ficam lado a lado */
    table.rt tr:has(td.sz) { display: flex; flex-wrap: wrap; column-gap: 8px; }
    table.rt tr:has(td.sz) td:not(.sz) { flex: 0 0 100%; }
    table.rt td.sz { flex: 1 0 15%; width: auto; text-align: center; }
    table.rt td.sz::before { float: none; display: block; margin: 0; line-height: 1.6; text-align: center; }
    table.rt td.sz input { width: 100% !important; max-width: none; text-align: center !important; }
    table.rt td:first-child { display: block; text-align: left; font-size: 15px; padding-bottom: 8px; }
    table.rt td:first-child::before { content: none; }
    table.rt td:empty { display: none; }
    table.rt td input, table.rt td select { max-width: 60%; }
    .card:has(> table.rt), .table:has(> table.rt) { padding: 0; }
    .bar > * { flex: 1 1 auto; }
    .tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-left: -16px; margin-right: -16px; padding: 0 16px; }
    .tabs::-webkit-scrollbar { display: none; }
    .tabs a { flex: none; }
  }
  @media print {
    .adm { display: block; }
    .adm__side, .no-print { display: none !important; }
    .adm__main { padding: 0; }
    body { background: #fff; }
  }
</style>
