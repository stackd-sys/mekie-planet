---
import '@fontsource-variable/inter';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Popup from '../components/Popup.astro';
import { site } from '../data/site';
import { products, cartInfo } from '../data/products';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  overlayHeader?: boolean;
  popup?: boolean;
  noindex?: boolean;
}
/* Preço e stock atuais, para o carrinho guardado no browser se manter certo */
const catalog = Object.fromEntries(products.map((p) => [p.id, cartInfo(p)]));
const {
  title,
  description = 'Mekie Planet, marca de roupa da Ericeira. T-shirts, hoodies, caps e meias com os bordados Mekie. Envio em 7 dias úteis, grátis acima de 65€.',
  image = '/images/site/hero.webp',
  overlayHeader = false,
  popup = true,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Loja online`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html
  lang="pt-PT"
  data-free-shipping={site.freeShippingFrom}
  data-newsletter-endpoint={site.newsletterWebhook}
  data-welcome-code={site.welcomeCode}
  data-email={site.email}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/images/site/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/site/icon.png" />
    <meta name="theme-color" content="#f5f5f4" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_PT" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.url.pathname === '/' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'OnlineStore',
        name: site.name,
        url: site.url,
        logo: new URL('/images/site/logo.png', site.url).href,
        email: site.email,
        sameAs: [site.instagram],
      })} />
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">Saltar para o conteúdo</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    {popup && <Popup />}
    <script type="application/json" id="mekie-catalog" set:html={JSON.stringify(catalog)} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
