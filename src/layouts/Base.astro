---
import '@fontsource-variable/inter';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Popup from '../components/Popup.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';
import { cartInfo } from '../data/products';
import { organizationLd, websiteLd } from '../data/seo';
import { promoActive } from '../data/promo';
import { langOf, toPt, href, langs, htmlLang, ogLocale } from '../i18n';
import { useT } from '../i18n/ui';
import { shop, giftCatalogFor } from '../i18n/data';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  overlayHeader?: boolean;
  popup?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'product' | 'article';
}
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
/* Preço, stock e nomes atuais (na língua da página), para o carrinho guardado no browser se manter certo */
const catalog = Object.fromEntries([...shop(lang).products.map((p) => [p.id, { ...cartInfo(p), href: href(lang, `/produto/${p.slug}/`) }]), ...giftCatalogFor(lang).map((g) => [g.id, { ...g, href: href(lang, g.href) }])]);
const {
  title,
  description = t('meta.desc'),
  image = '/images/site/hero.webp',
  overlayHeader = false,
  popup = true,
  noindex = false,
  ogType = 'website',
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${t('meta.title')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
/* a mesma página nas outras línguas (o blog só existe em português) */
const ptPath = toPt(Astro.url.pathname);
const translated = href('en', ptPath) !== ptPath;
const alternates = translated ? langs.map((l) => ({ lang: l, url: new URL(href(l, ptPath), Astro.site) })) : [{ lang: 'pt' as const, url: canonical }];
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html
  lang={htmlLang[lang]}
  data-free-shipping={site.freeShippingFrom}
  data-promo={promoActive() ? '1' : undefined}
  data-newsletter-endpoint={site.newsletterWebhook}
  data-welcome-code={site.welcomeCode}
  data-email={site.email}
  data-ga4={site.analytics.ga4 || undefined}
  data-pixel={site.analytics.metaPixel || undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/images/site/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/images/site/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f5f4" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.url} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0].url} />}
    <link rel="manifest" href="/site.webmanifest" />
    {Astro.url.pathname === '/' && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">{t('skip')}</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    {popup && <Popup />}
    {(site.analytics.ga4 || site.analytics.metaPixel) && <CookieBanner />}
    <script type="application/json" id="mekie-catalog" set:html={JSON.stringify(catalog)} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
